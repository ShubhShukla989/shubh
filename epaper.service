[Unit]
Description=ePaper CMS Next.js Application
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=newsone
WorkingDirectory=/home/newsone/epaper-final/epaper-final/.next/standalone
Environment="NODE_ENV=production"
Environment="PORT=3000"
EnvironmentFile=/home/newsone/epaper-final/epaper-final/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=epaper

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/newsone/epaper-final/epaper-final/public/uploads /home/newsone/epaper-final/epaper-final/.next

# Resource limits
LimitNOFILE=65536
MemoryLimit=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
